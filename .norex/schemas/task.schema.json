{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Norex Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "lane",
    "status",
    "risk",
    "surfaces",
    "definition_of_done"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "lane": {
      "enum": [
        "FE",
        "BE",
        "ND"
      ]
    },
    "status": {
      "enum": [
        "BACKLOG",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "VALIDATION",
        "MIKE_REVIEW",
        "DONE",
        "DEFERRED",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "primary_model": {
      "type": "string"
    },
    "fallback_model": {
      "type": "string"
    },
    "active_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "handoff_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_impact": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_budget": {
      "type": "object"
    },
    "definition_of_ready": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
